<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gazebo (gz-sim) plugins — included from rover.urdf.xacro when use_sim:=true.
       Drive: 6-wheel skid-steer via the DiffDrive system (3 joints per side).
       Odometry: odom -> base_footprint published on /tf via the bridge. -->

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_middle_wheel_joint</left_joint>
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_middle_wheel_joint</right_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
      <!-- effective separation for 6-wheel skid steer, calibrated against gz
           ground truth (odom yaw overshoot factor 1.39 with geometric 0.38 m) -->
      <wheel_separation>${wheel_y * 2 * 1.39}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- Articulated mode: cap wheel friction below the wheelie threshold.
       DiffDrive is a velocity controller with unlimited torque, so when the
       front wheels catch a step lip the thrust (mu*m*g acting at ground level,
       CG 0.24 m up, rear contact 0.20 m back) flips the rover backwards once
       mu > 0.20/0.24 ~ 0.83 — independent of mass. mu1 0.7 keeps climbing
       ability (12 deg ramps need ~0.25) but lets wheels slip instead of
       flipping; lower lateral mu2 eases skid-steer scrub. Scoped to
       articulated only so the DART worlds keep their calibrated behavior. -->
  <xacro:if value="${articulated}">
    <xacro:macro name="wheel_friction" params="prefix">
      <gazebo reference="${prefix}_wheel_link">
        <mu1>0.7</mu1>
        <mu2>0.5</mu2>
      </gazebo>
    </xacro:macro>
    <xacro:wheel_friction prefix="left_front"/>
    <xacro:wheel_friction prefix="left_middle"/>
    <xacro:wheel_friction prefix="left_rear"/>
    <xacro:wheel_friction prefix="right_front"/>
    <xacro:wheel_friction prefix="right_middle"/>
    <xacro:wheel_friction prefix="right_rear"/>
  </xacro:if>

  <!-- 2D lidar on laser_frame -->
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <gz_frame_id>laser_frame</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
